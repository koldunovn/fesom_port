#!/bin/bash
#SBATCH --job-name=fesom_port_core2_864_2yr
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=04:00:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/core2_864_2yr/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/core2_864_2yr/slurm.%j.err

# 2-year CORE2 production run at the largest pre-built CORE2 partition
# (dist_864). Same configuration as the 512-rank version, just more
# ranks for ~1.5× wall-clock speed-up.
#
# 730 days × 86400 / 500 = 126144 steps. Year rollover at step 63072.
# 17 default vars × {daily, monthly} cadences. Salinity floor (S>=0.5)
# active to prevent the Baltic-spring-melt NaN cascade that killed the
# 512-rank run in spring 1959.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh

ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/core2_864_2yr
mkdir -p "$OUT_DIR"

# Streams override: daily + monthly on every default variable.
export FESOM_IO_CONFIG="$REPO/io.config.daily_monthly"

( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"
( cd "$REPO" && git status --short )  > "$OUT_DIR/status.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

DT=500
NSTEPS=126144
SNAP_EVERY=-1
JRA55_YEAR=1958

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date

echo "Exit code: $EXITCODE"
echo "Tail of run.log:"
tail -80 "$OUT_DIR/run.log"
echo "Tail of run.err:"
tail -20 "$OUT_DIR/run.err"
echo "Generated daily files:"
ls "$OUT_DIR"/*.fesom.*.daily.nc 2>/dev/null | wc -l
echo "Generated monthly files:"
ls "$OUT_DIR"/*.fesom.*.monthly.nc 2>/dev/null | wc -l
exit $EXITCODE
