#!/bin/bash
#SBATCH --job-name=kpp_k8_val
#SBATCH -p compute
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/kpp_k8_validate/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/kpp_k8_validate/slurm.%j.err

# Phase K8 validation (single aux->Kv = diffK(:,:,1) + guard removed; KPP is now
# a LIVE scheme):
#  (a) KPP FINITE check — KPP on, 100 steps dt=1800, 16r. First real multi-step
#      KPP run; confirm finite (no NaN, sane max|uv|, no uv>5 trip).
#  (b) PP byte-identity — KPP off, 200 steps dt=500, vs kpp_k5_validate/pp (the
#      K5 PP run, commit 5acabea). K6/K7/K8 add only KPP-path code, so PP must be
#      bit-for-bit identical.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

BASE=/work/ab0995/a270088/port/kpp_k8_validate
mkdir -p "$BASE/kpp" "$BASE/pp"
BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
PPREF=/work/ab0995/a270088/port/kpp_k5_validate/pp
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
SRC=/home/a/a270088/port2/fesom2_port

date
echo "=== (a) C KPP LIVE run (100 steps dt=1800, KPP on) — finite check ==="
FESOM_MIX_SCHEME=KPP FESOM_PRINT_EVERY=20 \
  srun -l "$BIN" "$MESH" "$BASE/kpp" 1800 100 100 "$PHC" 1958 \
  > "$BASE/kpp/run.log" 2> "$BASE/kpp/run.err"
echo "KPP run exit: $?"
echo "--- max|uv| trajectory (every 20 steps) ---"; grep -E "max.*uv|uv.*max" "$BASE/kpp/run.err" | tail -6
echo "--- any NaN / uv>5 / abort? ---"; grep -iE "nan|uv>5|abort|blow" "$BASE/kpp/run.err" | head -3; echo "(empty = clean)"

echo "=== (b) C PP byte-identity (200 steps dt=500, KPP off) vs kpp_k5_validate/pp ==="
srun -l "$BIN" "$MESH" "$BASE/pp" 500 200 200 "$PHC" 1958 \
  > "$BASE/pp/run.log" 2> "$BASE/pp/run.err"
echo "PP run exit: $?"
PYTHONPATH=/home/a/a270088/PYTHON "$PY" "$SRC/scripts/kpp_byteident_check.py" "$PPREF" "$BASE/pp"
date
