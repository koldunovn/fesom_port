#!/bin/bash
#SBATCH --job-name=fesom_dt1800_diag
#SBATCH -p compute
#SBATCH --nodes=2
#SBATCH --ntasks=144
#SBATCH --ntasks-per-node=72
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/core2_dt1800_diag/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/core2_dt1800_diag/slurm.%j.err

# E1: characterize the dt=1800 instability. Print every step.
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800
export FESOM_PRINT_EVERY=1     # log uv/eta/w/T/S/CG every step

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/core2_dt1800_diag
mkdir -p "$OUT_DIR"
BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

# dt=1800 (Fortran default), 120 steps, no streams/snapshots
DT=1800; NSTEPS=120; SNAP_EVERY=-1; JRA55_YEAR=1958
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "exit $?"; tail -130 "$OUT_DIR/run.log"
