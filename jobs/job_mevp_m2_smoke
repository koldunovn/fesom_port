#!/bin/bash
#SBATCH --job-name=mevp_m2
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=02:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/mevp/m2_smoke/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/mevp/m2_smoke/slurm.%j.err
#
# mEVP-port M2 gates:
#  (A) byte-gate — M2 binary, knob unset, 16r/200/dt500 vs baseline_2714071;
#  (B) 1r mEVP smoke — 200 steps dt=1800, FESOM_WHICH_EVP=1, FESOM_DIAG_MICE:
#      ice drifts (max_uice nonzero, evolving), no NaN, no HUGE-ice_strength;
#  (C) 1r std-EVP control — same config, knob unset, for the sanity compare.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

BIN=/home/a/a270088/port2/fesom2_port_zstar/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
BASELINE=/work/ab0995/a270088/port/mevp/baseline_2714071
BASE=/work/ab0995/a270088/port/mevp/m2_smoke
mkdir -p "$BASE/bytegate" "$BASE/mevp_1r" "$BASE/evp_1r"

unset FESOM_ALE FESOM_MIX_SCHEME FESOM_WHICH_EVP FESOM_DIAG_MICE
unset FESOM_TKE_DIAG FESOM_TKE_DUMP_DIR FESOM_TKE_DUMP_STEPS
unset FESOM_ALE_DUMP_DIR FESOM_KPP_DUMP_DIR FESOM_EVP_DUMP_DIR FESOM_IO_CONFIG

echo "=== (A) byte-gate: knob unset, 16r/200/dt500 ==="
md5sum "$BIN"
srun -l -n 16 "$BIN" "$MESH" "$BASE/bytegate" 500 200 25 "$PHC" 1958 \
    > "$BASE/bytegate/run.log" 2> "$BASE/bytegate/run.err"
echo "exit: $?"
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
CHECK=/home/a/a270088/port2/fesom2_port_zstar/scripts/kpp_byteident_check.py
PYTHONPATH=/home/a/a270088/PYTHON $PY "$CHECK" "$BASELINE" "$BASE/bytegate"
echo "byteident exit: $?"

echo "=== (B) 1r mEVP smoke: 200 steps dt=1800 ==="
export FESOM_WHICH_EVP=1
export FESOM_DIAG_MICE=1
srun -l -n 1 "$BIN" "$MESH" "$BASE/mevp_1r" 1800 200 50 "$PHC" 1958 \
    > "$BASE/mevp_1r/run.log" 2> "$BASE/mevp_1r/run.err"
echo "exit: $?"

echo "=== (C) 1r std-EVP control: 200 steps dt=1800 ==="
unset FESOM_WHICH_EVP
srun -l -n 1 "$BIN" "$MESH" "$BASE/evp_1r" 1800 200 50 "$PHC" 1958 \
    > "$BASE/evp_1r/run.log" 2> "$BASE/evp_1r/run.err"
echo "exit: $?"
unset FESOM_DIAG_MICE

echo "=== summary ==="
echo "--- mEVP mice-mon (first 3 / last 3):"
grep "mice-mon" "$BASE/mevp_1r/run.err" | head -3
grep "mice-mon" "$BASE/mevp_1r/run.err" | tail -3
echo "--- EVP control mice-mon (last 3):"
grep "mice-mon" "$BASE/evp_1r/run.err" | tail -3
echo "--- NaN scan (both):"
grep -ci "nan" "$BASE/mevp_1r/run.log" "$BASE/mevp_1r/run.err" \
              "$BASE/evp_1r/run.log" "$BASE/evp_1r/run.err" || true
echo "--- HUGE ice_strength fires:"
grep -c "HUGE ice_strength" "$BASE/mevp_1r/run.err" || echo "0 (expected: mEVP has no such trace)"
echo "--- final ocean stats (mEVP then EVP):"
tail -2 "$BASE/mevp_1r/run.log"
tail -2 "$BASE/evp_1r/run.log"
