#!/bin/bash
#SBATCH --job-name=mevp_cdump
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:20:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/mevp/cdump_16r/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/mevp/cdump_16r/slurm.%j.err
#
# mEVP-port M3: C-side per-substep dump run. Mirror of the Fortran
# work_mevp_dump run (job 25514438): 16r dist_16, dt=1800, 2 ocean steps,
# FESOM_WHICH_EVP=1, FESOM_EVP_DUMP_DIR. Same dump points/filenames
# (fesom_ice_maevp.c); diff with scripts/maevp_dump_diff.py against
# /work/ab0995/a270088/port/mevp/fdump_16r/dump.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

BIN=/home/a/a270088/port2/fesom2_port_zstar/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port/mevp/cdump_16r
export FESOM_EVP_DUMP_DIR=$OUT/dump
mkdir -p "$OUT" "$FESOM_EVP_DUMP_DIR"

unset FESOM_ALE FESOM_MIX_SCHEME FESOM_IO_CONFIG
unset FESOM_TKE_DIAG FESOM_TKE_DUMP_DIR FESOM_ALE_DUMP_DIR FESOM_KPP_DUMP_DIR
export FESOM_WHICH_EVP=1

srun -l "$BIN" "$MESH" "$OUT" 1800 2 1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
echo "exit: $?"
echo "=== dump files ==="; ls "$FESOM_EVP_DUMP_DIR" | wc -l
ls "$FESOM_EVP_DUMP_DIR" | head -10
