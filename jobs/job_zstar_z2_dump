#!/bin/bash
#SBATCH --job-name=z2_dump
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/zstar/z2_cdump/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/zstar/z2_cdump/slurm.%j.err
#
# Phase Z2 validation: C FESOM_ALE=zstar 16r dt=1800 3 steps with ALE dumps,
# then dump-diff the 'forcing' tag (water_flux, virtual_salt, relax_salt,
# real_salt_flux) vs the Fortran zstar reference dump (work_zstar_dump,
# job 25493084). Step 1 is the clean compare (identical IC; the C ocean state
# legitimately diverges at steps 2-3 until Z3-Z6 land).

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

BIN=/home/a/a270088/port2/fesom2_port_zstar/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

OUT=/work/ab0995/a270088/port/zstar/z2_cdump
FDUMP=/work/ab0995/a270088/port/zstar/fdump/dump
mkdir -p "$OUT/dump"

export FESOM_ALE=zstar
export FESOM_ALE_DUMP_DIR=$OUT/dump
export FESOM_ALE_DUMP_STEPS=3
srun -l "$BIN" "$MESH" "$OUT" 1800 3 -1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
echo "exit zstar: $?"

PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
echo "=== forcing tag: C zstar vs Fortran zstar ==="
PYTHONPATH=/home/a/a270088/PYTHON $PY \
    /home/a/a270088/port2/fesom2_port_zstar/scripts/ale_dump_diff.py \
    "$FDUMP" "$OUT/dump" forcing
echo "=== full tag table (context; steps 2-3 expected to diverge pre-Z3) ==="
PYTHONPATH=/home/a/a270088/PYTHON $PY \
    /home/a/a270088/port2/fesom2_port_zstar/scripts/ale_dump_diff.py \
    "$FDUMP" "$OUT/dump" 2>/dev/null | tail -4
tail -5 "$OUT/run.log"
