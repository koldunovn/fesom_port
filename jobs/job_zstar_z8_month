#!/bin/bash
#SBATCH --job-name=z8_month
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=02:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/zstar/z8_month/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/zstar/z8_month/slurm.%j.err
#
# Phase Z8: 30-day dt=1800 16r zstar stability run (1440 steps). Checks:
# clean exit, max|uv| bounded, SSH range physical, SST/SSS sane. Watch the
# Aleutian trench (el 194724) + the 1-ring hbar spread checkerboard indicator
# (zstar changes the barotropic operator).

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

BIN=/home/a/a270088/port2/fesom2_port_zstar/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
OUT=/work/ab0995/a270088/port/zstar/z8_month
mkdir -p "$OUT"
export FESOM_ALE=zstar
export FESOM_PRINT_EVERY=48
unset FESOM_ALE_DUMP_DIR FESOM_KPP_DUMP_DIR

srun -l "$BIN" "$MESH" "$OUT" 1800 1440 480 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
echo "exit: $?"
echo "=== last 3 stat lines ==="
grep -E "^ 0: +[0-9]+ +it=" "$OUT/run.log" | tail -3
echo "=== max uv over run ==="
grep -E "^ 0: +[0-9]+ +it=" "$OUT/run.log" | awk '{for(i=1;i<=NF;i++) if($i ~ /^uv=/){sub("uv=","",$i); if($i+0>m) m=$i+0}} END{print "max uv:", m}'
