#!/bin/bash
#SBATCH --job-name=z1_smoke
#SBATCH -p compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/zstar/z1_smoke/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/zstar/z1_smoke/slurm.%j.err
#
# Phase Z1 smoke: (a) FESOM_ALE=zstar dispatch runs 3 steps clean at 16r;
# (b) zstar cold-start geometry == linfs cold-start geometry (hnode bit-equal;
# helem <=1 ulp from the mean-of-3 formula; zbar_3d_n/Z_3d_n <=1 ulp from the
# commit recomputation) — compared via the step-1 ALE dumps of both modes.
# Until Z5 the zstar commit is a no-op, so the step-1 'hnode' dump IS the init
# state in both modes.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

BIN=/home/a/a270088/port2/fesom2_port_zstar/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

BASE=/work/ab0995/a270088/port/zstar/z1_smoke
Z=$BASE/zstar; L=$BASE/linfs
mkdir -p "$Z/dump" "$L/dump"

echo "=== run A: FESOM_ALE=zstar, 3 steps, dumps on ==="
export FESOM_ALE=zstar
export FESOM_ALE_DUMP_DIR=$Z/dump
export FESOM_ALE_DUMP_STEPS=3
srun -l "$BIN" "$MESH" "$Z" 1800 3 -1 "$PHC" 1958 \
    > "$Z/run.log" 2> "$Z/run.err"
echo "exit zstar: $?"
grep "ALE mode" "$Z/run.log" | head -2

echo "=== run B: FESOM_ALE=linfs, 3 steps, dumps on ==="
export FESOM_ALE=linfs
export FESOM_ALE_DUMP_DIR=$L/dump
srun -l "$BIN" "$MESH" "$L" 1800 3 -1 "$PHC" 1958 \
    > "$L/run.log" 2> "$L/run.err"
echo "exit linfs: $?"

echo "=== cold-start geometry: zstar vs linfs (step-1 dumps) ==="
PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
PYTHONPATH=/home/a/a270088/PYTHON $PY \
    /home/a/a270088/port2/fesom2_port_zstar/scripts/ale_dump_diff.py \
    "$L/dump" "$Z/dump" 2>&1 | grep -E "hnode|helem|zbar|Z_3d|worst|step|tag" | head -40

echo "=== zstar run tail ==="
tail -8 "$Z/run.log"
