#!/bin/bash
#SBATCH --job-name=mevp_c2yr
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=01:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/mevp/c_mevp_2yr/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/mevp/c_mevp_2yr/slurm.%j.err
#
# Phase M5: C mEVP (FESOM_WHICH_EVP=1) 2yr dt=1800 864r (35040 steps,
# 1958-1959) for the climate comparison against the Fortran mEVP reference
# (/work/ab0995/a270088/port/mevp/fortran_mevp_2yr) and the diff-of-diffs
# against the std-EVP pair (C: valid_2yr-class runs; F: fortran_linfs_2yr_b).
# Monthly streams (default 17 vars incl. uice/vice for the VECTOR gate).

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port_zstar
BIN=$REPO/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

OUT=/work/ab0995/a270088/port/mevp/c_mevp_2yr
mkdir -p "$OUT"
rm -f "$OUT"/*.nc "$OUT"/run.log "$OUT"/run.err   # self-clean
( cd "$REPO" && git rev-parse HEAD ) > "$OUT/SHA.txt"
( cd "$REPO" && git status --short ) > "$OUT/status.txt"

export FESOM_WHICH_EVP=1
export FESOM_PRINT_EVERY=1000
unset FESOM_ALE FESOM_MIX_SCHEME FESOM_IO_CONFIG
unset FESOM_TKE_DUMP_DIR FESOM_TKE_REPLAY_DIR FESOM_TKE_DIAG
unset FESOM_ALE_DUMP_DIR FESOM_KPP_DUMP_DIR FESOM_EVP_DUMP_DIR

srun -l --ntasks=864 "$BIN" "$MESH" "$OUT" 1800 35040 -1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
echo "exit: $?"
echo "--- tail run.log ---";    tail -3 "$OUT/run.log"
echo "--- blowup / uv>5 ? ---"; grep -iE "blowup|uv>5|nan" "$OUT/run.err" | tail -3
echo "--- monthly files ---";   ls "$OUT"/*.monthly.nc 2>/dev/null | wc -l
