#!/bin/bash
#SBATCH --job-name=z9_zstar2yr
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=01:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/zstar/c_zstar_2yr/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/zstar/c_zstar_2yr/slurm.%j.err
#
# Phase Z9: C zstar+KPP 2yr dt=1800 864r (35040 steps, 1958-1959) for the
# climate comparison against the NEW Fortran zstar reference
# (/work/ab0995/a270088/port/zstar/fortran_zstar_2yr) and the contrast check
# against fortran_linfs_2yr_b. Daily + monthly streams (io.config override).

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port_zstar/env.sh
ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port_zstar
BIN=$REPO/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

OUT=/work/ab0995/a270088/port/zstar/c_zstar_2yr
mkdir -p "$OUT"
( cd "$REPO" && git rev-parse HEAD ) > "$OUT/SHA.txt"
( cd "$REPO" && git status --short ) > "$OUT/status.txt"

export FESOM_ALE=zstar
export FESOM_IO_CONFIG="$REPO/io.config.daily_monthly"
export FESOM_PRINT_EVERY=1000
unset FESOM_ALE_DUMP_DIR FESOM_KPP_DUMP_DIR

srun -l --ntasks=864 "$BIN" "$MESH" "$OUT" 1800 35040 -1 "$PHC" 1958 \
    > "$OUT/run.log" 2> "$OUT/run.err"
echo "exit: $?"
echo "--- tail run.log ---";    tail -3 "$OUT/run.log"
echo "--- blowup / uv>5 ? ---";  grep -iE "blowup|uv>5|nan" "$OUT/run.err" | tail -3
echo "--- monthly files ---";    ls "$OUT"/*.monthly.nc 2>/dev/null | wc -l
