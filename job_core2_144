#!/bin/bash
#SBATCH --job-name=core2_144r_dbg
#SBATCH -p compute
#SBATCH --ntasks-per-node=128
#SBATCH --ntasks=144
#SBATCH --time=00:15:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/core2_144r/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/core2_144r/slurm.%j.err

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh

ulimit -s 204800

OUT_DIR=/work/ab0995/a270088/port/core2_144r
mkdir -p "$OUT_DIR"

BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

# Short run — expect NaN within 50-100 steps based on scaling trend.
DT=500
NSTEPS=100
SNAP_EVERY=10     # snapshots every 10 steps to inspect field evolution
JRA55_YEAR=1958
export FESOM_PRINT_EVERY=1

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit: $?"
date
echo "Last steps:"
grep "^.*it=" "$OUT_DIR/run.log" | tail -10
