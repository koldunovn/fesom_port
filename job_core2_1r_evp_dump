#!/bin/bash
#SBATCH --job-name=evp_dump_1r
#SBATCH -p compute
#SBATCH --ntasks-per-node=1
#SBATCH --ntasks=1
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/evp_dump_logs/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/evp_dump_logs/slurm.%j.err

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

mkdir -p /work/ab0995/a270088/port/evp_dump_logs

STAMP="$(date +%s)_${SLURM_JOB_ID}"
OUT_DIR=/work/ab0995/a270088/port/evp_dump_run_1r_${STAMP}
export FESOM_EVP_DUMP_DIR=/work/ab0995/a270088/port/evp_dump_1r_${STAMP}

mkdir -p "$OUT_DIR" "$FESOM_EVP_DUMP_DIR"

echo "OUT_DIR=$OUT_DIR"
echo "FESOM_EVP_DUMP_DIR=$FESOM_EVP_DUMP_DIR"

BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

DT=500
NSTEPS=2
SNAP_EVERY=2
export FESOM_PRINT_EVERY=1
JRA55_YEAR=1958

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date
echo "Exit code: $EXITCODE"
echo "DUMP_DIR_FINAL=$FESOM_EVP_DUMP_DIR"
ls "$FESOM_EVP_DUMP_DIR" | head
tail -5 "$OUT_DIR/run.err"
exit $EXITCODE
