#!/bin/bash
#SBATCH --job-name=fesom_port_core2_32
#SBATCH -p compute
#SBATCH --ntasks-per-node=32
#SBATCH --ntasks=32
#SBATCH --time=01:00:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/core2_32r/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/core2_32r/slurm.%j.err

# Load the spack-loaded gcc + openmpi + serial netcdf-c stack matching the
# build (env.sh sets the same plus OMPI_MCA_*/UCX_* runtime knobs).
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh

ulimit -s 204800

OUT_DIR=/work/ab0995/a270088/port/core2_32r
mkdir -p "$OUT_DIR"

BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

# One model month at dt=500s:
#   30 days × 86400 s/day / 500 s = 5184 steps.
# Daily snapshots: snap_every = 173 (= 86500 s ≈ 1 day) → ~30 files of ~95 MB each.
DT=500
NSTEPS=5184
SNAP_EVERY=173
JRA55_YEAR=1958

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date

echo "Exit code: $EXITCODE"
echo "Output:"
ls -la "$OUT_DIR"
echo "Tail of run.log:"
tail -40 "$OUT_DIR/run.log"
exit $EXITCODE
