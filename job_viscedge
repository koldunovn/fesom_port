#!/bin/bash
#SBATCH --job-name=viscedge
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:12:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/viscedge/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/viscedge/slurm.%j.err

# VERIFY: count interior edges the viscosity (el<0) wrongly skips at 864 ranks.
# >0 on any rank == viscous-coupling gap at rank boundaries (the hypothesis).
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800
REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/viscedge
mkdir -p "$OUT_DIR"
export FESOM_DIAG_VISCEDGE=1
BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 3 -1 "$PHC" 1958 > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"
echo "=== viscedge gaps (ranks reporting interior-edge skips) ==="
grep "\[viscedge" "$OUT_DIR/run.err" | head -40
echo "=== total ranks reporting a gap ==="
grep -c "\[viscedge" "$OUT_DIR/run.err"
