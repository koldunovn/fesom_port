#!/bin/bash
#SBATCH --job-name=fesom_port_core2_512_2yr
#SBATCH -p compute
#SBATCH --nodes=4
#SBATCH --ntasks=512
#SBATCH --ntasks-per-node=128
#SBATCH --time=08:00:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/core2_512_2yr/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/core2_512_2yr/slurm.%j.err

# 2-year CORE2 production run: 1958-01-01 → 1960-01-01.
# 17 default vars × {daily, monthly} cadences via FESOM_IO_CONFIG override.
# No instantaneous snapshots (snap_every = -1).
#
# dt history:
#   dt=2700 (Fortran default w/ ice)  — job 24508873, blew up at step ~150
#   dt=900                            — job 24508948, blew up at step 19775
#                                        (uv runaway, late July 1958)
#   dt=500 (current)                  — proven stable in the 1-day baseline
#
# 730 days × 86400 / 500 = 126144 steps. Year rollover at step 63072
# (start of 1959) — fesom_jra55_step_cal calls open_year to swap in the
# next year's JRA55 forcing files.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh

ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/core2_512_2yr
mkdir -p "$OUT_DIR"

# Streams override: daily + monthly on every default variable.
export FESOM_IO_CONFIG="$REPO/io.config.daily_monthly"

( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"
( cd "$REPO" && git status --short )  > "$OUT_DIR/status.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

# 2 years × 365 days × 86400 s / 500 s per step = 126144 steps.
DT=500
NSTEPS=126144
SNAP_EVERY=-1     # < 0 disables snapshots; streams are the output
JRA55_YEAR=1958

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date

echo "Exit code: $EXITCODE"
echo "Tail of run.log:"
tail -80 "$OUT_DIR/run.log"
echo "Tail of run.err (heartbeat):"
tail -20 "$OUT_DIR/run.err"
echo "Generated daily files:"
ls "$OUT_DIR"/*.fesom.*.daily.nc 2>/dev/null | wc -l
echo "Generated monthly files:"
ls "$OUT_DIR"/*.fesom.*.monthly.nc 2>/dev/null | wc -l
echo "Sample sizes:"
ls -la "$OUT_DIR"/temp.fesom.*.daily.nc "$OUT_DIR"/temp.fesom.*.monthly.nc 2>/dev/null
exit $EXITCODE
