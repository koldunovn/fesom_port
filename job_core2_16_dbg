#!/bin/bash
#SBATCH --job-name=fesom_port_core2_16_dbg
#SBATCH -p compute
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:15:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/core2_16r_dbg/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/core2_16r_dbg/slurm.%j.err

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh

ulimit -s 204800

OUT_DIR=/work/ab0995/a270088/port/core2_16r_dbg
mkdir -p "$OUT_DIR"

BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

# Diagnose: 100 steps with per-step max stats, no snapshots.
DT=500
NSTEPS=100
SNAP_EVERY=10            # 10 snapshots over 100 steps for field inspection
JRA55_YEAR=1958
export FESOM_PRINT_EVERY=1

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit: $?"
date
echo "Last step rows:"
grep -E "^[ ]*[0-9]+:[ ]+[0-9]+[ ]+[0-9]" "$OUT_DIR/run.log" | tail -20
