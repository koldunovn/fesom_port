#!/bin/bash
#SBATCH --job-name=dt1800_slv
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:25:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dt1800_sshslv/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dt1800_sshslv/slurm.%j.err
# Compare implicit-FS damping strength (|d_eta|/|ssh_rhs|) at 87875 to Fortran [FSSH].
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800
REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/dt1800_sshslv
mkdir -p "$OUT_DIR"
export FESOM_DIAG_SSHSLV=87875
export FESOM_DIAG_MICE=1
BIN="$REPO/build/fesom_port"; MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
date; srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 4560 -1 "$PHC" 1958 > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"; date
echo "=== C [sshslv] at 87875 — early (1000,2000,3000) + approach (4540-4556) ==="
grep "\[sshslv" "$OUT_DIR/run.err" | awk '{for(i=1;i<=NF;i++)if($i~/step/){s=$(i+1)}} s==1000||s==2000||s==3000||(s>=4540&&s<=4556)'
