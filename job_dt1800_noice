#!/bin/bash
#SBATCH --job-name=dt1800_noice
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dt1800_noice/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dt1800_noice/slurm.%j.err

# ISOLATION: dt=1800 with the ENTIRE ice subsystem OFF (dyn + adv + thermo).
# EVP-off alone still blew (m_ice singular at step 4611 on a healthy ocean),
# so the suspect is ice thermo. This run decides ocean-vs-ice:
#   reaches 5000 clean -> ocean is fine, bug is in the ice (thermo/coupling);
#   still blows ~day 95 -> the ocean is the real root cause.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/dt1800_noice
mkdir -p "$OUT_DIR"
export FESOM_NO_ICE_DYN=1
export FESOM_NO_ICE_ADV=1
export FESOM_NO_ICE_THERMO=1
export FESOM_DIAG_MICE=1

( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

date
srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 5000 -1 "$PHC" 1958 \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"
date
echo "=== reached step? (run.log tail — watch uv/eta) ==="; tail -3 "$OUT_DIR/run.log"
echo "=== CG NaN / FATAL count ==="; grep -ciE "FATAL|nan" "$OUT_DIR/run.err"
echo "=== last CG step markers ==="; grep -E "\] done — | entering " "$OUT_DIR/run.err" | tail -4
