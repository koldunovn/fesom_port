#!/bin/bash
#SBATCH --job-name=kpp_k2_val
#SBATCH -p compute
#SBATCH --ntasks-per-node=16
#SBATCH --ntasks=16
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/kpp_k2_validate/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/kpp_k2_validate/slurm.%j.err

# Phase K2 validation: wscale sweep (captured at setup) + byte-identity recheck.
# K2 adds a static wscale + a gated sweep dump → PP path unchanged.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

BASE=/work/ab0995/a270088/port/kpp_k2_validate
OUT_K2=$BASE/k2
HEAD_REF=/work/ab0995/a270088/port/kpp_k0_byteident/head
mkdir -p "$OUT_K2" "$BASE/dump"
export FESOM_KPP_DUMP_DIR=$BASE/dump   # captures kpp_wscale_rank0.txt + kpp_init_rank0.txt at setup

BIN=/home/a/a270088/port2/fesom2_port/build/fesom_port
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
DT=500; NSTEPS=200; SNAP_EVERY=50
export FESOM_PRINT_EVERY=50
JRA55_YEAR=1958
# default mixing = PP (KPP off).

date
srun -l "$BIN" "$MESH" "$OUT_K2" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_K2/run.log" 2> "$OUT_K2/run.err"
echo "K2 exit: $?"
date

PY=/work/ab0995/a270088/mambaforge/envs/nereus/bin/python
echo "=== byte-identity vs HEAD (must PASS) ==="
PYTHONPATH=/home/a/a270088/PYTHON "$PY" \
    /home/a/a270088/port2/fesom2_port/scripts/kpp_byteident_check.py "$HEAD_REF" "$OUT_K2"
echo "=== K2 C wscale sweep vs python reference ==="
cd /home/a/a270088/port2/fesom2_port/scripts
"$PY" kpp_wscale_reference.py "$BASE/dump/kpp_wscale_rank0.txt"
