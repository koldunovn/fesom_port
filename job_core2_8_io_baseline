#!/bin/bash
#SBATCH --job-name=fesom_port_io_baseline
#SBATCH -p compute
#SBATCH --ntasks-per-node=8
#SBATCH --ntasks=8
#SBATCH --time=01:00:00
#SBATCH -A ab0995
#SBATCH -o /home/a/a270088/port2/fesom2_port/tests/regression_reference/core2_1day_pre_io/slurm.%j.out
#SBATCH -e /home/a/a270088/port2/fesom2_port/tests/regression_reference/core2_1day_pre_io/slurm.%j.err

# Pre-IO-overhaul regression baseline. 172 steps × dt=500 = 1 model day.
# Snapshot at end is the reference for Task 3 / Task 4 bit-identity diffs.
# Run BEFORE landing any commit that changes JRA55 / SSS-runoff date logic.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh

ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR="$REPO/tests/regression_reference/core2_1day_pre_io"
mkdir -p "$OUT_DIR"

# Pin which commit produced this baseline. Task 3 / Task 4 verification
# scripts should print this so a future debugger knows which HEAD the
# bit-identity gate was set against.
( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"
( cd "$REPO" && git status --short )  > "$OUT_DIR/status.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

# 172 steps × 500 s = 86000 s ≈ 1 model day; snapshot at the final step only.
DT=500
NSTEPS=172
SNAP_EVERY=172
JRA55_YEAR=1958

date
srun -l "$BIN" "$MESH" "$OUT_DIR" "$DT" "$NSTEPS" "$SNAP_EVERY" "$PHC" "$JRA55_YEAR" \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
EXITCODE=$?
date

echo "Exit code: $EXITCODE"
echo "Tail of run.log:"
tail -60 "$OUT_DIR/run.log"
echo "Tail of run.err:"
tail -10 "$OUT_DIR/run.err"
echo "Generated snapshot files:"
ls -la "$OUT_DIR"/snap_*.nc 2>/dev/null
exit $EXITCODE
