#!/bin/bash
#SBATCH --job-name=dt1800_512
#SBATCH -p compute
#SBATCH --nodes=4
#SBATCH --ntasks=512
#SBATCH --time=01:00:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dt1800_512/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dt1800_512/slurm.%j.err
# PARTITION TEST (user): 512 ranks. If the blow-up node differs from 87875(@864)
# and 47138(@256), the eruption point tracks the partition => mesh-partitioning bug.
source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800
REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/dt1800_512
mkdir -p "$OUT_DIR"
export FESOM_DIAG_MICE=1
BIN="$REPO/build/fesom_port"; MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc
date; srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 4700 -1 "$PHC" 1958 > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"; date
echo "=== mice-mon: first eruption (where + when) ==="
grep "\[mice-mon\]" "$OUT_DIR/run.err" | awk '$5+0>50 || $7+0>10 {print; c++} c>=6{exit}'
echo "--- last 6 ---"; grep "\[mice-mon\]" "$OUT_DIR/run.err" | tail -6
