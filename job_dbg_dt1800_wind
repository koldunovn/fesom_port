#!/bin/bash
#SBATCH --job-name=dbg_dt1800_wind
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dbg_dt1800_wind/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dbg_dt1800_wind/slurm.%j.err

# DEBUG: dt=1800 to past the ~step-4436 m_ice runaway. FESOM_DIAG_MICE prints
# per-step global max m_ice + max ice speed (with gids) -> catches the trigger
# node/step and tells us EVP-velocity-driven vs mass-driven. Default monthly IO.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/dbg_dt1800_wind
mkdir -p "$OUT_DIR"
export FESOM_DIAG_MICE=1

( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"
( cd "$REPO" && git status --short )  > "$OUT_DIR/status.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

date
srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 5000 -1 "$PHC" 1958 \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"
date
echo "=== m_ice trajectory (every 200 steps + last 10) ==="
grep "\[mice-mon\]" "$OUT_DIR/run.err" | awk 'NR==1||NR%200==0'
grep "\[mice-mon\]" "$OUT_DIR/run.err" | tail -10
