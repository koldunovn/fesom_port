#!/bin/bash
#SBATCH --job-name=dt1800_bidiff
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dt1800_bidiff/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dt1800_bidiff/slurm.%j.err

# DECISIVE TEST: opt_visc=7 (biharmonic, visc_filt_bidiff) at dt=1800.
# Previous blow-up (opt_visc=5 + advection) was at step 4550, central-Arctic
# node gid 47138. If the biharmonic damping is the fix, this runs all 5000
# steps (~104 model-days) with m_ice staying physical.

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/dt1800_bidiff
mkdir -p "$OUT_DIR"
export FESOM_DIAG_MICE=1

( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

date
srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 5000 -1 "$PHC" 1958 \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"
date
echo "=== m_ice max trajectory (every 500 steps + last 12) ==="
grep "\[mice-mon\]" "$OUT_DIR/run.err" | awk 'NR==1||NR%500==0'
grep "\[mice-mon\]" "$OUT_DIR/run.err" | tail -12
