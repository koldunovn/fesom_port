#!/bin/bash
#SBATCH --job-name=dt1800_vmult025
#SBATCH -p compute
#SBATCH --nodes=7
#SBATCH --ntasks=864
#SBATCH --time=00:30:00
#SBATCH -A ab0995
#SBATCH -o /work/ab0995/a270088/port/dt1800_vmult025/slurm.%j.out
#SBATCH -e /work/ab0995/a270088/port/dt1800_vmult025/slurm.%j.err

# DECISIVE TEST: use_wsplit=OFF (FESOM_PHASE1_USE_WSPLIT=0) at dt=1800.
# The C had wsplit=ON (from work_pi); the CORE2 dt=1800 reference
# (work_core, work_linfs_d1800) uses use_wsplit=.false. The mismatch is
# invisible at dt=500 (vertical CFL < maxcfl, splitter never fires) but at
# dt=1800 the splitter fired in the deep-convecting central Arctic, diverging
# the C from the stable Fortran path. With wsplit OFF the C should now reach
# all 5000 steps (~104 model-days) with m_ice staying physical (previous
# blow-up: step 4555, gid 87875, uice->3e7).

source /sw/etc/profile.levante
source /home/a/a270088/port2/fesom2_port/env.sh
ulimit -s 204800

REPO=/home/a/a270088/port2/fesom2_port
OUT_DIR=/work/ab0995/a270088/port/dt1800_vmult025
mkdir -p "$OUT_DIR"
export FESOM_DIAG_MICE=1
export FESOM_DIAG_SPREAD=23926
export FESOM_VISC_MULT=0.25

( cd "$REPO" && git rev-parse HEAD ) > "$OUT_DIR/SHA.txt"

BIN="$REPO/build/fesom_port"
MESH=/pool/data/AWICM/FESOM2/MESHES_FESOM2.1/core2
PHC=/home/a/a270088/FESOM_port/fesom2/tests/data/INITIAL/phc3.0/phc3.0_winter.nc

date
srun -l "$BIN" "$MESH" "$OUT_DIR" 1800 6500 -1 "$PHC" 1958 \
    > "$OUT_DIR/run.log" 2> "$OUT_DIR/run.err"
echo "Exit code: $?"
date
echo "=== m_ice max trajectory (every 500 steps + last 12) ==="
grep "\[mice-mon\]" "$OUT_DIR/run.err" | awk 'NR==1||NR%500==0'
grep "\[mice-mon\]" "$OUT_DIR/run.err" | tail -12
